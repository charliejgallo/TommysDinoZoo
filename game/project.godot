; Engine configuration file.
config_version=5

[application]

config/name="Tommy's Dino Zoo"
config/version="1.0.0"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"
boot_splash/bg_color=Color(1, 0.968627, 0.901961, 1)
boot_splash/show_image=true
boot_splash/image="res://splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true
boot_splash/minimum_display_time=1200

[autoload]

Dev="*res://scripts/dev.gd"
Lang="*res://scripts/core/lang.gd"
Content="*res://scripts/core/content.gd"
Controls="*res://scripts/core/controls.gd"
Game="*res://scripts/core/game.gd"
Sfx="*res://scripts/core/sfx.gd"
Icons="*res://scripts/core/icons.gd"
Missions="*res://scripts/core/missions.gd"
Music="*res://scripts/core/music.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

environment/defaults/default_clear_color=Color(1, 0.968627, 0.901961, 1)

textures/vram_compression/import_etc2_astc=true

anti_aliasing/quality/msaa_3d=2

[audio]

general/text_to_speech=true
